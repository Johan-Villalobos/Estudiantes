{
  "openapi": "3.0.0",
  "info": {
    "title": "API Notas Estudiantiles",
    "version": "1.0.0",
    "description": "API para la gestión de estudiantes y sus notas. Proyecto académico desarrollado con Node.js, Supabase y desplegado en Render."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    },
    {
      "url": "https://tu-backend.onrender.com",
      "description": "Servidor en producción"
    }
  ],
  "tags": [
    {
      "name": "Estudiantes",
      "description": "Operaciones relacionadas con estudiantes"
    },
    {
      "name": "Notas",
      "description": "Operaciones relacionadas con notas"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health Check",
        "description": "Verifica que el servidor esté funcionando correctamente",
        "responses": {
          "200": {
            "description": "Servidor activo",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "message": "API Notas Estudiantiles 🎓"
                }
              }
            }
          }
        }
      }
    },

    "/estudiantes": {
      "get": {
        "tags": ["Estudiantes"],
        "summary": "Obtener todos los estudiantes",
        "responses": {
          "200": {
            "description": "Lista de estudiantes",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "nombre": "Juan Pérez",
                    "correo": "juan@example.com"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Estudiantes"],
        "summary": "Crear un nuevo estudiante",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "nombre": "María Gómez",
                "correo": "maria@example.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Estudiante creado correctamente"
          },
          "400": {
            "description": "Datos inválidos"
          }
        }
      }
    },

    "/estudiantes/{id}": {
      "get": {
        "tags": ["Estudiantes"],
        "summary": "Obtener un estudiante por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estudiante encontrado"
          },
          "404": {
            "description": "Estudiante no encontrado"
          }
        }
      },
      "put": {
        "tags": ["Estudiantes"],
        "summary": "Actualizar un estudiante",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "nombre": "Juan Actualizado",
                "correo": "nuevo@email.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estudiante actualizado"
          }
        }
      },
      "delete": {
        "tags": ["Estudiantes"],
        "summary": "Eliminar un estudiante",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estudiante eliminado"
          }
        }
      }
    },

    "/notas": {
      "get": {
        "tags": ["Notas"],
        "summary": "Obtener todas las notas",
        "responses": {
          "200": {
            "description": "Lista de notas",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "estudiante_id": 1,
                    "materia": "Matemáticas",
                    "nota": 4.5
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Notas"],
        "summary": "Crear una nueva nota",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "estudiante_id": 1,
                "materia": "Física",
                "nota": 4.2
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Nota creada correctamente"
          }
        }
      }
    },

    "/notas/{id}": {
      "get": {
        "tags": ["Notas"],
        "summary": "Obtener una nota por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nota encontrada"
          }
        }
      },
      "put": {
        "tags": ["Notas"],
        "summary": "Actualizar una nota",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "materia": "Química",
                "nota": 4.8
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nota actualizada"
          }
        }
      },
      "delete": {
        "tags": ["Notas"],
        "summary": "Eliminar una nota",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nota eliminada"
          }
        }
      }
    }
  }
}